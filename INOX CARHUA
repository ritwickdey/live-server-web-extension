            border-radius: 0.75rem; /* rounded-xl */
            padding: 1.5rem; /* p-6 */
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 1.875rem; /* text-3xl */
            font-weight: 700; /* font-bold */
            color: white;
            transition: transform 0.2s;
        }
        .acc-category-lg:hover {
            transform: scale(1.02);
        }
        
        /* Estilo para las tarjetas de categoría pequeñas (circulares) */
        .acc-category-sm {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .acc-category-sm:hover {
            opacity: 0.8;
        }
        .acc-category-sm .img-circle {
            width: 144px; /* w-36 */
            height: 144px; /* h-36 */
            border-radius: 9999px; /* rounded-full */
            object-fit: cover;
