    <!-- ===== MODAL 2D (POP-UP) - ZOOM DE IMAGEN (GENERAL) ===== -->
    <div id="zoom-modal" class="hidden fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-lg p-4 shadow-2xl w-11/12 max-w-4xl relative">
            <button id="close-zoom-modal" class="absolute -top-4 -right-4 bg-orange-600 text-white rounded-full p-2 z-10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
            <h3 class="text-2xl font-bold text-gray-800 mb-4">Imagen Ampliada</h3>
            <img id="modal-image" src="VISTA DELANTE COCINA A LEÑA.png" alt="Vista ampliada" class="w-full h-auto object-contain" style="max-height: 80vh;" onerror="this.onerror=null; this.src='https://placehold.co/800x600/e2e8f0/64748b?text=Imagen+no+disponible'">
        </div>
    </div>


    <!-- ===== SCRIPT DE NAVEGACIÓN Y MODAL (ACTUALIZADO) ===== -->
<script>
    // --- Lógica de Navegación de PÁGINA ÚNICA ---
    let pages;
    let navLinks;
    
    function navigateTo(pageId) {
        if (!pages) {
            pages = document.querySelectorAll('.page');
        }
        if (!navLinks) {
            navLinks = document.querySelectorAll('nav a');
        }

        pages.forEach(page => {
            page.classList.remove('active');
        });
        
        const nextPage = document.getElementById(pageId);
        if (nextPage) {
            nextPage.classList.add('active');
        } else {
            document.getElementById('page-main').classList.add('active');
            pageId = 'page-main';
        }

        navLinks.forEach(link => {
            link.classList.remove('text-orange-500', 'border-b-2', 'border-orange-500');
            link.classList.add('text-gray-300');
            
            const navMap = {
                'page-hornos': 'nav-productos',
                'page-parrilleros': 'nav-productos',
                'page-chiferas': 'nav-productos',
                'page-cocinas-industriales': 'nav-productos',
                'page-horno-9-latas': 'nav-productos',
                'page-horno-4-latas': 'nav-productos',
                'page-parrillero-1m': 'nav-productos',
                'page-parrillero-80cm': 'nav-productos',
                'page-cocina-chifera-3h': 'nav-productos',
                'page-cocina-chifera-2h': 'nav-productos',
                'page-cocina-industrial': 'nav-productos',
                'page-contacto': 'nav-contacto',
                'page-main': 'nav-productos'
            };

            const parentNavId = navMap[pageId];
            if (parentNavId && link.id === parentNavId) {
                link.classList.add('text-orange-500', 'border-b-2', 'border-orange-500');
                link.classList.remove('text-gray-300');
            }
        });
        
        window.scrollTo(0, 0);
    }

    // --- FUNCIÓN PARA ABRIR MODAL DE WHATSAPP (NUEVA) ---
    function openWhatsAppModal(productName) {
        document.getElementById('whatsapp-product-name').textContent = productName;
        document.getElementById('whatsapp-modal').classList.remove('hidden');
        
        const phone1 = '51975768030';
        const phone2 = '51986774062';
        const message = `Hola, me interesa cotizar: ${productName}`;
        
        document.getElementById('wsp-link-1').href = `https://wa.me/${phone1}?text=${encodeURIComponent(message)}`;
        document.getElementById('wsp-link-2').href = `https://wa.me/${phone2}?text=${encodeURIComponent(message)}`;
    }

        // --- SCRIPT DE MODALES ---
    document.addEventListener('DOMContentLoaded', () => {
        pages = document.querySelectorAll('.page');
        navLinks = document.querySelectorAll('nav a');
        navigateTo('page-main');

          // ===== SCRIPT DE ZOOM DE IMÁGENES (NUEVO) =====
        const zoomModal = document.getElementById('zoom-modal');
        const modalImage = document.getElementById('modal-image');
        const closeZoomModal = document.getElementById('close-zoom-modal');

        // Abrir modal de zoom al hacer clic en botón "Ver Imagen Ampliada"
        document.querySelectorAll('.open-zoom-button').forEach(button => {
            button.addEventListener('click', (e) => {
                e.preventDefault();
                const mainImage = button.parentElement.querySelector('img:not(.gallery-thumbnail)');
                if (mainImage) {
                    modalImage.src = mainImage.src;
                    zoomModal.classList.remove('hidden');
                }
            });
        });

        // Abrir zoom al hacer clic en miniaturas
        document.querySelectorAll('.gallery-thumbnail').forEach(thumbnail => {
            thumbnail.addEventListener('click', () => {
                const imageUrl = thumbnail.getAttribute('data-image');
                if (imageUrl) {
                    modalImage.src = imageUrl;
                    zoomModal.classList.remove('hidden');
                }
            });
        });

        // Cerrar modal de zoom
        if (closeZoomModal) {
            closeZoomModal.addEventListener('click', () => {
                zoomModal.classList.add('hidden');
            });
        }

        if (zoomModal) {
            zoomModal.addEventListener('click', (e) => {
                if (e.target === zoomModal) {
                    zoomModal.classList.add('hidden');
                }
            });
        }

        // Cerrar modal de WhatsApp
        const closeWhatsappModal = document.getElementById('close-whatsapp-modal');
        const whatsappModal = document.getElementById('whatsapp-modal');

        if (closeWhatsappModal) {
            closeWhatsappModal.addEventListener('click', () => {
                whatsappModal.classList.add('hidden');
            });
        }

        if (whatsappModal) {
            whatsappModal.addEventListener('click', (e) => {
                if (e.target === whatsappModal) {
                    whatsappModal.classList.add('hidden');
                }
            });
        }
    });
</script>

</body>
</html>
